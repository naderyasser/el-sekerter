# انسخ الملف ده باسم .env وحط فيه القيم الحقيقية.
# .env مش بيترفع على جيتهاب — شوف .gitignore

# مفتاح Claude. مكانه هنا بس — متكتبوش في أي ملف تاني ومتبعتوش في شات.
ANTHROPIC_API_KEY=

# التوكن اللي التطبيق بيبعته في هيدر Authorization: Bearer <token>
# ولّده بأمر: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SEKERTER_API_TOKEN=

# مفتاح Django. ولّده بنفس الأمر اللي فوق.
DJANGO_SECRET_KEY=

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# مستوى تفكير الموديل: low | medium | high | xhigh | max
# low أسرع وأرخص وكفاية للمواعيد العادية. ارفعه لو لقيت أخطاء في حساب التواريخ.
SEKERTER_EFFORT=low
