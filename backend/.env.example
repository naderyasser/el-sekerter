# انسخ هذا الملف باسم .env وحط فيه القيم الحقيقية.
# .env ما يترفع على جيتهاب — شوف .gitignore

# ── سيرفر الذكاء ──────────────────────────────────────────────────────────
# عنوان السيرفر ومفتاحه. ما فيه أسماء شركات هنا — حط عنوانك وخلاص.
SEKERTER_BASE_URL=https://agent.client-radar.org
SEKERTER_API_KEY=

# صيغة السيرفر — الحاجة الوحيدة التقنية اللي لازم تعرفها عنه:
#
#   messages → POST /v1/messages          (المفتاح في هيدر x-api-key)
#   chat     → POST /v1/chat/completions  (المفتاح في هيدر Authorization)
#
# لو توثيق سيرفرك يقول «Messages API» حط messages.
# لو يقول «OpenAI-compatible» أو «chat/completions» حط chat.
# لو مو متأكد جرّب وحدة وشغّل try_model — لو رجع ٤٠٤ بدّل للثانية.
SEKERTER_FORMAT=messages

# اسم الموديل زي ما سيرفرك يعرفه. سيرفرك يرفض أي اسم ما يخدمه.
# شوف قايمة اللي يخدمه: curl $SEKERTER_BASE_URL/v1/models
SEKERTER_MODEL=deepseek-chat

# إزاي الموديل يطلّع الأوامر:
#
#   native → استدعاء أدوات حقيقي. أدق، ويحتاج سيرفر يدعمه.
#   text   → الأوامر كـJSON جوّه نص الرد. يشتغل على أي سيرفر.
#
# فيه سيرفرات تستقبل tools وترميها في صمت — خصوصًا اللي قدّامها واجهة جلسات
# محادثة مو API حقيقي. وقتها الموديل يفهم كلامك صح ويرد «أبشر، سجّلته»
# و**ما يتسجّل ولا موعد**. الفشل هذا شكله نجاح فيعدّي من غير ما أحد ينتبه.
#
# شغّل try_model وهو يقول لك: إذا طلع «رد كلام بس وما استدعى أداة» حط text.
SEKERTER_TOOLS=native

# مستوى تفكير الموديل: low | medium | high | xhigh | max
# يشتغل مع أنثروبيك المباشرة بس، وباقي السيرفرات تتجاهله.
SEKERTER_EFFORT=low

# ── اتصال مباشر بمزوّد سحابي (اختياري) ────────────────────────────────────
# سيبها فاضية إذا مستخدم SEKERTER_BASE_URL فوق. هذي بس إذا تبي تكلّم
# أنثروبيك أو ديب سيك مباشرة عشان تقارن الجودة.
SEKERTER_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# ── السيرفر ───────────────────────────────────────────────────────────────
# التوكن اللي التطبيق يرسله في هيدر Authorization: Bearer <token>
# ولّده بأمر: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SEKERTER_API_TOKEN=

# مفتاح Django. ولّده بنفس الأمر اللي فوق.
DJANGO_SECRET_KEY=

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
