# انسخ هذا الملف باسم .env وحط فيه القيم الحقيقية.
# .env ما يترفع على جيتهاب — شوف .gitignore

# ── المزوّد ────────────────────────────────────────────────────────────────
# الاختيار مبني على **صيغة السيرفر** مو على اسم الشركة:
#
#   claude   → صيغة Anthropic (POST /v1/messages، هيدر x-api-key).
#              أنثروبيك نفسها، أو أي بوابة متوافقة معها.
#   deepseek → صيغة OpenAI (POST /v1/chat/completions).
#              سحابة ديب سيك، أو موديل محلي بـvLLM أو Ollama أو llama.cpp.
#
# لو بوابتك بتقول «Anthropic-compatible» أو «Messages API» → claude.
SEKERTER_PROVIDER=claude

# اسم الموديل زي ما السيرفر يعرفه.
# فاضي = الافتراضي بتاع المزوّد (claude-opus-5 أو deepseek-chat).
# مع موديل محلي لازم تحطه هنا — السيرفر يرفض أي اسم ما يخدمه.
SEKERTER_MODEL=

# مستوى تفكير الموديل — Claude بس: low | medium | high | xhigh | max
# low أسرع وأرخص وكافي للمواعيد العادية. ارفعه إذا لقيت أخطاء في التواريخ.
SEKERTER_EFFORT=low

# ── المفاتيح ──────────────────────────────────────────────────────────────
# حط اللي تحتاجه حسب المزوّد. لا تكتبها في أي ملف ثاني ولا ترسلها في شات —
# أي مفتاح يمر على شات يعتبر محروق ولازم تلغيه وتولّد غيره.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ── بوابة بصيغة Anthropic ─────────────────────────────────────────────────
# فاضي = أنثروبيك نفسها. مليان = عنوان بوابتك، والمكتبة تركّب عليه
# /v1/messages وترسل المفتاح في هيدر x-api-key.
#
#   ANTHROPIC_BASE_URL=https://agent.client-radar.org
#   SEKERTER_MODEL=deepseek-chat
#   ANTHROPIC_API_KEY=<مفتاح بوابتك>
#
# لما يتحط عنوان هنا، بتنشال من الطلب حاجات خاصة بأنثروبيك ما تفهمها أي
# بوابة تانية: تكاش البرومبت، output_config، fallbacks، وstrict في الأدوات.
ANTHROPIC_BASE_URL=

# عنوان السيرفر المتوافق مع OpenAI.
#
# فاضي = https://api.deepseek.com — سحابة ديب سيك.
#
# **موديل محلي**: حط عنوان سيرفرك هنا، وغالبًا ينتهي بـ/v1 لأن ده المسار
# اللي مكتبة OpenAI تركّب عليه /chat/completions. أمثلة:
#
#   DEEPSEEK_BASE_URL=http://127.0.0.1:8080/v1     # نفس الجهاز
#   DEEPSEEK_BASE_URL=http://192.168.1.20:11434/v1 # جهاز ثاني في الشبكة
#
# المفتاح في هذي الحالة مفتاح سيرفرك مو مفتاح ديب سيك، وكلام الشغل ما يطلع
# برّه شبكتك أبدًا. تأكد إن الجهاز اللي شغّال عليه Django يوصل للعنوان ده.
DEEPSEEK_BASE_URL=

# ── السيرفر ───────────────────────────────────────────────────────────────
# التوكن اللي التطبيق يرسله في هيدر Authorization: Bearer <token>
# ولّده بأمر: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SEKERTER_API_TOKEN=

# مفتاح Django. ولّده بنفس الأمر اللي فوق.
DJANGO_SECRET_KEY=

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
