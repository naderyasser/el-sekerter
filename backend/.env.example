# انسخ هذا الملف باسم .env وحط فيه القيم الحقيقية.
# .env ما يترفع على جيتهاب — شوف .gitignore

# ── المزوّد ────────────────────────────────────────────────────────────────
# claude أو deepseek. التبديل بينهم ما يحتاج أي تغيير في الكود.
#
#   claude   → أدق في فهم العامية السعودية وحساب التواريخ، وأغلى.
#   deepseek → أرخص بكثير، وأضعف في العامية والتواريخ النسبية.
#
# جرّب الاثنين على كلامك الحقيقي قبل ما تستقر على واحد.
SEKERTER_PROVIDER=deepseek

# فاضي = الافتراضي بتاع المزوّد (claude-opus-5 أو deepseek-chat).
SEKERTER_MODEL=

# مستوى تفكير الموديل — Claude بس: low | medium | high | xhigh | max
# low أسرع وأرخص وكافي للمواعيد العادية. ارفعه إذا لقيت أخطاء في التواريخ.
SEKERTER_EFFORT=low

# ── المفاتيح ──────────────────────────────────────────────────────────────
# حط اللي تحتاجه حسب المزوّد. لا تكتبها في أي ملف ثاني ولا ترسلها في شات —
# أي مفتاح يمر على شات يعتبر محروق ولازم تلغيه وتولّد غيره.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# فاضي = https://api.deepseek.com
DEEPSEEK_BASE_URL=

# ── السيرفر ───────────────────────────────────────────────────────────────
# التوكن اللي التطبيق يرسله في هيدر Authorization: Bearer <token>
# ولّده بأمر: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SEKERTER_API_TOKEN=

# مفتاح Django. ولّده بنفس الأمر اللي فوق.
DJANGO_SECRET_KEY=

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
